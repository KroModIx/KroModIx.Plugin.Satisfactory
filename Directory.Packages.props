<Project>
  <ItemGroup>
    <!-- v1.21.0: IDescriptionParser.ToHtml + CreateRichView (Rich-HTML-Renderer
         via Avalonia.HtmlRenderer). Vorher v1.18 mit IHostServices.Images. -->
    <PackageVersion Include="KroModIx.Plugin.Contracts" Version="1.34.0" />
    <!-- v0.13.0: Attrappen der Host-Baukaesten fuer das Testprojekt, aus
         demselben Tag wie die Contracts. -->
    <PackageVersion Include="KroModIx.Plugin.TestKit" Version="1.34.0" />
    <PackageVersion Include="Avalonia" Version="12.1.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <!-- v0.13.0: Markdown→HTML fuer den Rich-HTML-Description-Renderer. ficsit.app
         liefert Descriptions als Markdown (Headings, Bold, Links, Listen); der
         Host-Baukasten _host.Descriptions.ToHtml erwartet BBCode oder rohes HTML
         und wuerde Markdown-Syntax im HtmlPanel sichtbar lassen. Markdig wandelt
         Markdown erst zu HTML, dann macht der Host den Rest (Passthrough auf HTML). -->
    <PackageVersion Include="Markdig" Version="1.3.2" />

    <!-- Tests (v0.13.0): das Repo hatte bis dahin kein Testprojekt, obwohl
         der Install-Pfad ins Spielverzeichnis schreibt. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
  </ItemGroup>
</Project>
